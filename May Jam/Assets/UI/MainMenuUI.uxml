<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="root" style="
        width: 100%;
        height: 100%;
        background-color: rgb(5, 5, 15);
        align-items: center;
        justify-content: center;
        flex-direction: column;
    ">
        <!-- Title -->
        <ui:VisualElement name="title-container" style="
            align-items: center;
            margin-bottom: 60px;
        ">
            <ui:Label name="title" text="MAY JAM" style="
                font-size: 72px;
                color: rgb(255, 220, 80);
                -unity-font-style: bold;
                letter-spacing: 8px;
            "/>
            <ui:Label name="subtitle" text="find the light" style="
                font-size: 18px;
                color: rgb(150, 150, 180);
                letter-spacing: 4px;
                margin-top: -10px;
            "/>
        </ui:VisualElement>

        <!-- Buttons -->
        <ui:VisualElement name="button-container" style="
            align-items: center;
            flex-direction: column;
            width: 300px;
        ">
            <ui:Button name="play-button" text="PLAY" style="
                width: 100%;
                height: 55px;
                margin-bottom: 16px;
                background-color: rgb(255, 200, 50);
                color: rgb(5, 5, 15);
                font-size: 20px;
                -unity-font-style: bold;
                border-width: 0;
                border-radius: 4px;
                letter-spacing: 3px;
            "/>
            <ui:Button name="exit-button" text="EXIT" style="
                width: 100%;
                height: 55px;
                background-color: rgba(255, 255, 255, 0);
                color: rgb(150, 150, 180);
                font-size: 20px;
                -unity-font-style: bold;
                border-color: rgb(80, 80, 100);
                border-width: 1px;
                border-radius: 4px;
                letter-spacing: 3px;
            "/>
        </ui:VisualElement>

        <!-- Footer -->
        <ui:Label name="footer" text="made for may game jam 2026" style="
            position: absolute;
            bottom: 24px;
            font-size: 12px;
            color: rgb(60, 60, 80);
            letter-spacing: 2px;
        "/>
    </ui:VisualElement>
</ui:UXML>