<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="root" style="
        width: 100%;
        height: 100%;
        background-color: rgb(5, 5, 15);
        align-items: center;
        justify-content: center;
        flex-direction: column;
    ">
        <ui:Label name="title" text="YOU WIN" style="
            font-size: 72px;
            color: rgb(255, 220, 80);
            -unity-font-style: bold;
            letter-spacing: 8px;
            margin-bottom: 16px;
        "/>
        <ui:Label name="subtitle" text="the light lives on" style="
            font-size: 18px;
            color: rgb(150, 150, 180);
            letter-spacing: 4px;
            margin-bottom: 60px;
        "/>
        <ui:Button name="play-again-button" text="PLAY AGAIN" style="
            width: 300px;
            height: 55px;
            margin-bottom: 16px;
            background-color: rgb(255, 200, 50);
            color: rgb(5, 5, 15);
            font-size: 20px;
            -unity-font-style: bold;
            border-width: 0;
            border-radius: 4px;
            letter-spacing: 3px;
        "/>
        <ui:Button name="menu-button" text="MAIN MENU" style="
            width: 300px;
            height: 55px;
            background-color: rgba(255, 255, 255, 0);
            color: rgb(150, 150, 180);
            font-size: 20px;
            -unity-font-style: bold;
            border-color: rgb(80, 80, 100);
            border-width: 1px;
            border-radius: 4px;
            letter-spacing: 3px;
        "/>
    </ui:VisualElement>
</ui:UXML>